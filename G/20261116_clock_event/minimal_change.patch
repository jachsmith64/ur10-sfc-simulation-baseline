+{
+  "parent": "0fd746f487cb9e5382b7e4249a3824c5c0c8bfe3",
+  "clock": {
+    "scale": 1,
+    "offset": "median(host time minus normalized cabinet time) from singleton timestamp groups",
+    "same_stamp_target": "merge only exact identical pose, discard the whole group on any target-pose disagreement",
+    "same_stamp_actual": "independently merge only exact identical actual TCP pose and speed, discard conflicting groups",
+    "long_gap_s": 0.04,
+    "quiet_nominal_gap_max_translation_m": 2e-06,
+    "noncritical_long_gap": "hold previous target across bracket, suppress right endpoint at the hold boundary, rejoin only in the following short bracket. Actual states are unfilled. Block if gap overlaps start or turn or exceeds the nominal translation limit.",
+    "singleton_target_consistency": {
+      "max_bridge_s": 0.04,
+      "plateau_tolerance_fraction": 0.02,
+      "local_bad_slope_departure_fraction": 0.25,
+      "rule": "Reject the single interior row only when the exterior pre/post intervals and the short bridge agree with the same signed plateau, and an interior interval disagrees. Retain bracket timestamps and interpolate from the two endpoints."
+    }
+  },
+  "events": {
+    "grid_s": 0.001,
+    "median_half_width_s": 0.012,
+    "min_persistence_s": 0.024,
+    "persistence_hysteresis_fraction": 0.025,
+    "zero_prepost_confirm_s": 0.1,
+    "zero_prepost_speed_fraction": 0.15,
+    "primary_start": [
+      0.1,
+      0.9
+    ],
+    "primary_reversal": [
+      0.9,
+      -0.9
+    ],
+    "diagnostic_spans": [
+      0.5,
+      0.8
+    ],
+    "deceleration": "last descending crossing at each threshold before the main zero, with evidence of the preceding positive plateau",
+    "gap": "interpolate only brackets at most 40 ms; keep event uncertain when the detector crosses unavailable data"
+  },
+  "gates": {
+    "main_marker_ms": 50,
+    "max_new_speed_peak_fraction": 0.1,
+    "max_new_axial_endpoint_excess_mm": 0.05,
+    "max_added_stable_speed_rmse_mm_s": 0.25,
+    "nominal_stable_speed_error_fraction": 0.02,
+    "nominal_max_physical_speed_fraction": 1.5
+  }
+}
diff --git a/G/20261116_clock_event/clock_map.py b/G/20261116_clock_event/clock_map.py
new file mode 100644
index 0000000..e1574c6
--- /dev/null
+++ b/G/20261116_clock_event/clock_map.py
@@ -0,0 +1,121 @@
+"""Build separate replay-target and evaluation knots from the fixed cabinet clock."""
+import numpy as np
+
+
+def groups(cabinet):
+    if np.any(np.diff(cabinet)<-1e-8):
+        raise ValueError("Cabinet time runs backwards")
+    return np.split(np.arange(len(cabinet)),np.flatnonzero(np.diff(cabinet)>1e-8)+1)
+
+
+def select(same_stamp,field):
+    chosen=[]
+    result=[]
+    for inds in same_stamp:
+        i=int(inds[0])
+        if not np.all(field[inds]==field[i]):
+            result.extend((int(j),"excluded_conflicting_timestamp",None) for j in inds)
+            continue
+        chosen.append(i)
+        result.append((i,"kept",i))
+        result.extend((int(j),"merged_identical_payload",i) for j in inds[1:])
+    return np.array(chosen),sorted(result)
+
+
+def contradictory_plateau_rows(t,idx,pose,speed,policy):
+    """Exclude isolated phase-inconsistent rows anchored by the adjacent straight segment."""
+    x=pose[idx,0]*1000
+    lag=np.diff(t)
+    slopes=np.diff(x)/lag
+    rules=policy["singleton_target_consistency"]
+    evidence=[]
+    for i in range(2,len(idx)-2):
+        if t[i+1]-t[i-1]>rules["max_bridge_s"]+1e-9 or max(lag[i-2],lag[i+1])>rules["max_bridge_s"]+1e-9:
+            continue
+        bridge=(x[i+1]-x[i-1])/(t[i+1]-t[i-1])
+        aim=np.sign(bridge)*speed
+        knots=[slopes[i-2],bridge,slopes[i+1]]
+        bad=max(abs(slopes[i-1]-bridge),abs(slopes[i]-bridge))
+        if aim and max(abs(v-aim) for v in knots)<=rules["plateau_tolerance_fraction"]*speed and bad>rules["local_bad_slope_departure_fraction"]*speed:
+            evidence.append(dict(excluded_source_index=int(idx[i]),trusted_source_endpoints=idx[[i-1,i+1]].tolist(),
+                  mapped_bracket_s=t[[i-1,i+1]].tolist(),interior_velocities_mm_s=slopes[i-1:i+1].tolist(),
+                  adjacent_and_bridge_mm_s=[float(v) for v in knots], reason="isolated phase-discordant target on independently bounded plateau"))
+    excluded={v["excluded_source_index"] for v in evidence}
+    if any(i in excluded for row in evidence for i in row["trusted_source_endpoints"]):
+        raise ValueError("Overlapping target repairs are not supported")
+    return excluded,evidence
+
+
+def map_clocks(src,rec,policy):
+    h=src["host_time_s"]
+    cab=src["cabinet_time_s"]
+    target=src["target_tcp_pose"]
+    observed=np.column_stack([src["actual_tcp_pose"],src["actual_tcp_speed"]])
+    cluster=groups(cab)
+    intercept_residual=h-(cab-cab[0])
+    anchor=np.array([c[0] for c in cluster if len(c)==1])
+    offset=float(np.median(intercept_residual[anchor]))
+    mapped=(cab-cab[0])+offset
+    qt,td=select(cluster,target)
+    actual_i,ad=select(cluster,observed)
+    discord,field_consistency=contradictory_plateau_rows(mapped[qt],qt,target,rec["speed_mm_s"],policy)
+    qt=np.array([i for i in qt if i not in discord])
+    T=mapped[qt]
+    nominal=target[qt].copy()
+    raw_nominal=nominal.copy()
+    max_gap=policy["long_gap_s"]
+    allowed=policy["quiet_nominal_gap_max_translation_m"]
+    gaps=[]
+    blocking=[]
+    for i in np.flatnonzero(np.diff(T)>max_gap+1e-9):
+        lo,hi=T[i:i+2]
+        movement=float(np.linalg.norm(raw_nominal[i+1,:3]-raw_nominal[i,:3]))
+        intersects=[key for key in ("start","turn") if lo<rec["windows_s"][key][1] and hi>rec["windows_s"][key][0]]
+        rejoin=i+2<len(T) and T[i+2]-hi<=max_gap+1e-9
+        # Blocks touching inferred startup or reversal are never filled.
+        valid=not intersects and movement<=allowed and rejoin
+        if valid:
+            nominal[i+1]=nominal[i]
+        r=dict(start_s=float(lo),end_s=float(hi),seconds=float(hi-lo),left_source_index=int(qt[i]),
+               right_source_index=int(qt[i+1]),observed_tip_displacement_um=movement*1e6,
+               intersects_critical=intersects,accepted_bounded_target_hold=bool(valid),
+               right_return_index=int(qt[i+2]) if rejoin else None,
+               rejoin_s=[float(hi),float(T[i+2])] if rejoin else None,
+               actual_capture_gap_not_filled=True,
+               interpretation="Bounded nominal hold; no actual motion inferred.")
+        gaps.append(r)
+        if not valid:
+            blocking.append(r)
+    dt_actual=np.diff(mapped[actual_i])
+    actual_gaps=[dict(source_indices=actual_i[i:i+2].tolist(),mapped_s=mapped[actual_i[i:i+2]].tolist(),
+                      seconds=float(dt_actual[i]))
+                 for i in np.flatnonzero(dt_actual>max_gap+1e-9)]
+    for g in actual_gaps:
+        lo,hi=g["mapped_s"]
+        if any(lo<rec["windows_s"][k][1] and hi>rec["windows_s"][k][0] for k in ("start","turn")):
+            blocking.append(g|{"kind":"unavailable_actual_critical"})
+    decisions=[]
+    suppressed={g["right_source_index"] for g in gaps if g["accepted_bounded_target_hold"]}
+    for (i,action,representative),(j,act_action,act_i) in zip(td,ad,strict=True):
+        assert i==j
+        decisions.append(dict(index=i,host_s=float(h[i]),cabinet_s=float(cab[i]),mapped_host_s=float(mapped[i]),
+            target_action=("excluded_local_field_inconsistency" if i in discord else "bounded_hold_boundary" if i in suppressed else action),
+            target_rep_index=None if i in discord else representative,
+            actual_action=act_action,actual_rep_index=act_i))
+    d=1000*(h[anchor]-mapped[anchor])
+    offsets=[float(np.median(intercept_residual[ix])*1000) for ix in np.array_split(anchor,4)]
+    receipt=dict(clock_scale=1.,cabinet_origin_s=float(cab[0]),offset_s=offset,singleton_count=int(len(anchor)),
+                 residual_quantile_ms=np.percentile(d,[0,5,25,50,75,95,100]).tolist(),
+                 offset_by_time_quartile_ms=offsets,largest_abs_residual_ms=float(np.max(abs(d))),
+                 arrival_uncertainty="No direct sample-time anchor. Residuals include arrival variation, getter order and unknown constant delay. Fixed offset is an estimate.",
+                 actual_mapping="actual TCP pose and speed are validated jointly within equal stamps; other actual fields and camera are not shifted",
+                 target_conflict_rows=int(sum(a=="excluded_conflicting_timestamp" for _,a,_ in td)),
+                 actual_conflict_rows=int(sum(a=="excluded_conflicting_timestamp" for _,a,_ in ad)),
+                 target_identical_rows_merged=int(sum(a=="merged_identical_payload" for _,a,_ in td)),
+                 actual_identical_rows_merged=int(sum(a=="merged_identical_payload" for _,a,_ in ad)),
+                 field_consistency_exclusions=field_consistency,long_target_gaps=gaps,actual_gaps=actual_gaps,blocking_gaps=blocking,
+                 decisions=decisions)
+    arrays=dict(target_index=qt,target_mapped_host_s=T,derived_target_tcp_pose=nominal,
+                all_mapped_host_s=mapped,actual_index=actual_i,actual_mapped_host_s=mapped[actual_i],
+                actual_original_host_s=h[actual_i],target_original_host_s=h[qt])
+    return arrays,receipt
diff --git a/G/20261116_clock_event/refit_y.py b/G/20261116_clock_event/refit_y.py
new file mode 100644
index 0000000..de0410f
--- /dev/null
+++ b/G/20261116_clock_event/refit_y.py
@@ -0,0 +1,160 @@
+"""Reuse the authorized clock-corrected X reference for physical-only N reconstruction."""
+import argparse
+from pathlib import Path
+
+import numpy as np
+from run_clock_event import (ROOT, core, servo, prior, old, TRIALS, WINDOW_PATH, CASE,
+                             replace_nominal, source_data, write, analyze)
+
+
+def integrate(sweep,folder,ctx,initial_q,force,hook,pulse=0.):
+    trace,_=prior.integrate(sweep,folder,ctx,CASE,force,initial_q,pulse,execution=hook)
+    assert not np.any(trace["remaining"]) and not np.any(trace["remaining_dot"])
+    return trace
+
+
+def plant_for(poses,folder):
+    code=old.disturbance
+    original_q=core.aconfig.INIT_Q
+    original_dc=code.measure_dc_compliance
+    try:
+        # Re-estimate the inherited static-position frequency response. Here qdot_nom=0.
+        core.aconfig.INIT_Q=poses[len(poses)//2].copy()
+        code.measure_dc_compliance=lambda: original_dc(old.model())
+        plant=code.measure_plant(old.model())
+    finally:
+        core.aconfig.INIT_Q=original_q
+        code.measure_dc_compliance=original_dc
+    code.save_plant(plant,folder/"plant.npz")
+    return plant
+
+
+def trial_refit(folder,trial,rec,frozen,sweep,pre,pair_path,decision):
+    folder.mkdir()
+    src,_,_,ctx,q0,_=servo.case_inputs(trial,rec,source_data(trial,rec),frozen)
+    timebase=core.data_arrays(pre/trial/"input.npz")
+    pair=core.read(pair_path/trial/"status.json")
+    input_hash=core.sha(pre/trial/"input.npz")
+    assert decision["sufficient_for_current_Y_baseline"] and decision["unchanged_protection_pass"]
+    assert input_hash==pair["mapped_input_sha256"]==decision["input_sha256"]
+    np.testing.assert_array_equal(q0,timebase["initial_q_rad"])
+    for key in ("dq","dqd"):
+        np.testing.assert_array_equal(ctx["scaled"][key],timebase[key])
+    np.testing.assert_array_equal(ctx["pressure"],timebase["pressure"])
+    ctx=replace_nominal(ctx,timebase["q_nom"],timebase["nominal_xyz_m"])
+    t=ctx["c"]["t"]
+    env=old.model()
+    env.reset(timebase["q_nom"][0])
+    j=env.jacp()
+    direction=j.T@np.linalg.solve(j@j.T,[0.,1.,0.])
+    ref=prior.Schedule(rec,rec["bases_um"])
+    hook=servo.VelocityReference(core,prior.TimingLogger,timebase["qdot_nom_rad_s"],CASE["command_ms"])
+    no_fit=core.data_arrays(pair_path/trial/"velocity_on"/"trace.npz")
+    assert not np.any(no_fit["Fd"]) and not np.any(no_fit["common_delta_y_m"])
+    np.testing.assert_array_equal(no_fit["q_nominal"],timebase["q_nom"])
+    ft=src["frame_host_time_s"]
+    valid=src["frame_valid"]
+    a=src["A_centered_um"]
+    residual=np.interp(ft,t,no_fit["physical_e_um"])-a
+    medians={name:float(np.median(residual[valid & prior.mask(ft,rec["windows_s"][name],ft[-1])]))
+             for name in prior.PLATFORMS}
+    ctx["corr"]=prior.common_correction(t,prior.Schedule(rec,medians),direction)
+    plant=plant_for(timebase["q_nom"],folder)
+    force=np.zeros(len(t))
+    y_attempt=[]
+    attempts=[]
+    best=None
+    reference=-np.inf
+    quiet=0
+    metadata=core.read(old.PROJECT/"prepared_A"/trial/"source.json")
+    for i in range(len(prior.PLAN["iterations"])+1):
+        if i:
+            residual=np.interp(t,ft[valid],a[valid])-trace["physical_e_um"]
+            force=force+prior.PLAN["iterations"][i-1]*old.inverse(residual,plant)
+        tag=f"N_fit_{i}"
+        trace=integrate(sweep,folder/tag,ctx,q0,force,hook)
+        scores=prior.score(src,metadata|rec,t,trace["physical_e_um"],ref)
+        y_attempt.append(trace["physical_e_um"])
+        values=[scores[name][layer]["fit"] for name in prior.FIT_WINDOWS for layer in ("raw","processed")]
+        fit=min(v for v in values if v is not None)
+        attempts.append(dict(name=tag,min_fit=fit,force_sha256=servo.array_id(force),
+                             force_peak_N=float(np.max(abs(force))),scores=scores))
+        if best is None or fit>best[0]:
+            best=(fit,trace,force.copy(),i)
+        if fit-reference>=prior.CONFIG["minimum_material_fit_gain"]:
+            reference,quiet=fit,0
+        else:
+            quiet+=1
+        if best[0]>=prior.PLAN["fit_target"] or quiet>=prior.CONFIG["consecutive_iterations_without_material_gain"]:
+            break
+    fit,chosen,force,index=best
+    pulses={}
+    for label,amplitude in (("plus",1.),("minus",-1.)):
+        probe=integrate(sweep,folder/("micro_"+label),ctx,q0,force,hook,amplitude)
+        delta=probe["physical_e_um"]-chosen["physical_e_um"]
+        micro=probe["actual_micro_q"]
+        np.testing.assert_array_equal(probe["q_velocity_ff_rad"],chosen["q_velocity_ff_rad"])
+        np.testing.assert_array_equal(probe["Fd"],chosen["Fd"])
+        assert not delta[:801].any() and np.sign(delta[801])==np.sign(amplitude)
+        assert np.any(micro[800:856]) and not micro[:800].any() and not micro[856:].any()
+        pulses[label+"_delta_y_um"]=delta
+        pulses[label+"_micro_q_rad"]=micro[800:856:8]
+    zero_corr=prior.common_correction(t,prior.Schedule(rec,dict.fromkeys(prior.PLATFORMS,0.)),direction)
+    no_public=integrate(sweep,folder/"same_force_no_public",ctx|dict(corr=zero_corr),q0,force,hook)
+    fitted_axis,g,f=analyze(t,chosen["physical_xyz_m"][:,0],chosen["vx_m_s"]*1000,rec)
+    measured=core.read(pre/trial/"input.json")["mapped_actual"]["events"]
+    markers={}
+    for k in ("start50","turn_xmax","return50"):
+        a0,b0=measured[k]["time_s"],fitted_axis["events"][k]["time_s"]
+        markers[k]=None if a0 is None or b0 is None else (b0-a0)*1000
+    lock_fields=dict(t=t,fit_y_um=chosen["physical_e_um"],all_attempt_y_um=np.stack(y_attempt),force_N=force,
+        fitted_xyz_m=chosen["physical_xyz_m"],vx_m_s=chosen["vx_m_s"],remaining_m=chosen["remaining"],
+        remaining_dot_m_s=chosen["remaining_dot"],guarded_updated=chosen["updated"],
+        common_command_y_m=ctx["corr"]["common_delta_y_m"],common_delta_q=ctx["corr"]["common_delta_q"],
+        physical_common_effect_y_um=chosen["physical_e_um"]-no_public["physical_e_um"],
+        no_fit_y_um=no_fit["physical_e_um"],score_reference_um=ref.at(t)[0],
+        feedback_reference_um=ctx["reference"].at(t)[0],
+        velocity_ff_at_ticks_rad=chosen["q_velocity_ff_rad"][::8],**pulses)
+    np.savez_compressed(folder/"refit_review.npz",**lock_fields)
+    status=dict(best_index=index,best_min_fit=fit,physical_Y_major_windows_gate=fit>=prior.PLAN["fit_min"],
+           fitted_X_events_ms=markers,common_residual_platform_um=medians,
+           initial_stationary_y_um=float(chosen["physical_e_um"][0]),
+           frequency_response_sha256=core.sha(folder/"plant.npz"),plant_qdot_nom_rad_s=[0.]*6,
+           attempts=attempts,positive_micro_peak_um=float(pulses["plus_delta_y_um"].max()),
+           negative_micro_peak_um=float(pulses["minus_delta_y_um"].min()),pulse_first_response_s=.801,
+           pulse_pass=True,paired_X_historical_gate=pair["gate"]["pass_all"],
+           mapped_X_input_sha256=input_hash)
+    write(folder/"status.json",status)
+    print(trial,"N FIT",fit,"signed pulse",status["positive_micro_peak_um"],status["negative_micro_peak_um"],flush=True)
+    return status
+
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--prepared",type=Path,required=True)
+    p.add_argument("--pairs",type=Path,required=True)
+    p.add_argument("--output",type=Path,required=True)
+    a=p.parse_args()
+    x_policy=ROOT/"x_reference_for_y.json"
+    decision=core.read(x_policy)
+    assert decision["continuation_authorized_by_current_user"] and not decision["parallel_controls"]
+    paired=core.read(a.pairs/"receipt.json")
+    assert list(paired["conditions"])==list(TRIALS)
+    windows=core.read(WINDOW_PATH)["trials"]
+    a.output.mkdir()
+    integration=a.output/"integration_source"
+    integration.mkdir()
+    sweep=core.integration_module(integration)
+    frozen=core.context()
+    result={}
+    for k in TRIALS:
+        result[k]=trial_refit(a.output/k,k,windows[k],frozen,sweep,a.prepared,a.pairs,decision["results"][k])
+        write(a.output/"receipt.json",dict(results=result,formal_L_SFC=0,historical_X_gate=paired["x_pass"],
+            Y_baseline_motion_windows_pass=len(result)==3 and all(s["physical_Y_major_windows_gate"] for s in result.values()),
+            signed_micro_compensation_verified=len(result)==3 and all(s["pulse_pass"] for s in result.values()),
+            rule_sha256=core.sha(x_policy),source_window_sha256=core.sha(WINDOW_PATH),
+            paired_receipt_sha256=core.sha(a.pairs/"receipt.json")))
+
+
+if __name__=="__main__":
+    main()
diff --git a/G/20261116_clock_event/reproduce.ps1 b/G/20261116_clock_event/reproduce.ps1
